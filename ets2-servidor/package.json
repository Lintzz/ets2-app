{
  "name": "ets2_servidor",
  "version": "1.0.0",
  "description": "Servidor para Dashboard do Euro Truck Simulator 2 com addon nativo para leitura de memória.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "keywords": [
    "ets2",
    "dashboard",
    "telemetry",
    "electron"
  ],
  "author": "Lintz",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "node-addon-api": "^8.5.0",
    "robotjs": "^0.6.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "electron": "^38.2.2",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "name": "ETS2 Servidor",
        "executableName": "ETS2_Servidor",
        "icon": "icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "ets2_servidor",
            "iconUrl": "https://i.imgur.com/Onh99VV.png",
            "setupIcon": "icon.ico",
            "setupExe": "ETS2_Servidor-1.0.0 Setup.exe",
            "createDesktopShortcut": true
          }
        }
      ]
    }
  }
}
